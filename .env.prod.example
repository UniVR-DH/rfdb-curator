# .env.prod.example
# Copy to .env.prod and fill in real values. Do not commit .env.prod.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Every variable docker-compose.prod.yml marks `${VAR:?...}` must be present here
# or the stack refuses to start. CI validates that by running `compose config`
# against THIS file, so a newly required variable missing from here fails the
# build rather than the deploy.

# --- Identity ---------------------------------------------------------------
# The public domain. Caddy obtains a certificate for it on first start, so DNS
# must already resolve to this host or the ACME challenge fails.
#
# This is also the host RFDB's identifiers name: entity IRIs are
# https://rosfeatr.eu/rdf/data/{id} and are stored inside the triples. Serving
# them from a different domain does not make them resolve — it creates a second
# URL for the same resource. Keep this equal to the namespace in
# rfdb-core/rfdb_core/vocab.py, or accept that persisted IRIs are not fetchable.
RFDB_DOMAIN=rfdb.example.com

# --- Deploy mode (Task 9) ---------------------------------------------------
# unset  → READ  mode: oxigraph, garage, dataexplorer-backend,
#                      graphexplorer-frontend, proxy. No editor, no writer.
# full   → FULL  mode: the above plus curator-backend and curator-frontend.
COMPOSE_PROFILES=full

# What serves `/`. The editor in full mode; for a read-only public instance set
# this to graphexplorer-frontend:80 AND uncomment VITE_EXPLORER_BASE_PATH below,
# so the explorer's baked asset URLs match the root it is served from.
RFDB_ROOT_UPSTREAM=curator-frontend:80
# VITE_EXPLORER_BASE_PATH=/

# --- CORS -------------------------------------------------------------------
# JSON array string. With everything behind one origin there is no cross-origin
# request to allow, so this is just the public domain. No default on purpose:
# failing to start beats silently deploying a dev localhost origin. Must not
# contain "*" — both services abort at import time if it does.
CORS_ORIGINS=["https://rfdb.example.com"]

# --- Write tier -------------------------------------------------------------
# false = writes/deletes allowed (normal operation)
# true  = frozen editor: every write/delete route returns 403. Orthogonal to the
#         deploy mode above — mode decides whether a writer is deployed at all,
#         this decides whether a deployed one accepts writes.
READ_ONLY=false

# Per-file upload ceiling in MB (0 disables the app-level cap). Also becomes the
# proxy's `request_body max_size`, so an oversize upload is refused at the edge
# instead of being spooled to the writer's disk first.
MAX_UPLOAD_MB=500

LOG_LEVEL=INFO

# --- Branding ---------------------------------------------------------------
# Explorer window/header title. The app's code is domain-agnostic.
VITE_APP_TITLE=RFDB Explorer

# --- Object storage (Garage) for digital-copy scans -------------------------
# Generate ONCE per host and keep secret. The backends and Garage share these
# predefined values, so there is no generated secret to copy back:
#   GARAGE_RPC_SECRET:    openssl rand -hex 32
#   S3_ACCESS_KEY_ID:     printf 'GK%s' "$(openssl rand -hex 12)"
#   S3_SECRET_ACCESS_KEY: openssl rand -hex 32
#
# After the first `up` on a fresh volume set, bootstrap the cluster once:
#   COMPOSE_FILE=docker-compose.prod.yml ENV_FILE=.env.prod scripts/garage-init.sh
# A fresh garage_meta volume has no layout, bucket or key, and none of them can
# be declared in garage.toml.
GARAGE_RPC_SECRET=<64-hex>
S3_ACCESS_KEY_ID=GK<24-hex>
S3_SECRET_ACCESS_KEY=<64-hex>
S3_BUCKET=sources

# ---------------------------------------------------------------------------
# NOT here, on purpose
# ---------------------------------------------------------------------------
# VITE_API_BASE / VITE_READ_API_BASE — the frontends are built with both empty,
#   meaning "same origin", because the proxy routes /api/v1/curator/* and
#   /api/v1/dataexplorer/* on the domain that served the bundle. They are pinned
#   in docker-compose.prod.yml's build.args rather than exposed here.
#
#   Worth knowing if you ever do set them: they are ORIGINS, not API roots. The
#   client already puts /api/v1/{service} in every path, so a value ending in
#   /api yields /api/api/v1/curator/forms. This file used to prescribe exactly
#   that — the kind of error only a real request finds.
#
# VITE_EXPLORER_BASE — derived from RFDB_DOMAIN in compose
#   (https://${RFDB_DOMAIN}/explorer), so the editor's "Open in Explorer" link
#   cannot drift from the domain the explorer is actually served at.
#
# READ_ONLY_SHAPES — a single YAML anchor in each compose file feeds BOTH
#   backends (D11). An env knob would be two values that could be edited apart,
#   and clients would then get different `readOnly` flags depending on which
#   service answered.
#
# S3_ENDPOINT / S3_REGION — fixed by the topology (http://garage:3900, garage),
#   not a deployment choice.
