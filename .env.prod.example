# .env.prod.example
# Copy to .env.prod and fill in real values. Do not commit .env.prod.

# JSON array string. Must match the actual origin the browser sees.
# If everything is routed through the `proxy` service on one domain,
# this is just that one origin.
CORS_ORIGINS=["https://rfdb.example.com"]

# Baked into the frontend JS bundle at BUILD time (see frontend
# service's build.args in docker-compose.prod.yml) — changing this
# after the image is built has no effect until you rebuild.
# If /api is proxied under the same origin as the frontend, use a
# relative path here instead (e.g. /api) and skip CORS entirely.
VITE_API_BASE=https://rfdb.example.com/api

# false = writes/deletes allowed (normal operation)
# true  = demo mode, all write/delete API routes return 403
READ_ONLY=false

LOG_LEVEL=INFO

# --- Object storage (Garage) for source PDF scans -------------------------
# Generate ONCE per machine and keep secret (see scripts/garage-init.sh and
# .temp/temp-garage-prod-bootstrap-*.md). The backend and Garage share these
# predefined values so there is no generated secret to copy back.
#   GARAGE_RPC_SECRET:    openssl rand -hex 32
#   S3_ACCESS_KEY_ID:     printf 'GK%s' "$(openssl rand -hex 12)"
#   S3_SECRET_ACCESS_KEY: openssl rand -hex 32
GARAGE_RPC_SECRET=<64-hex>
S3_ACCESS_KEY_ID=GK<24-hex>
S3_SECRET_ACCESS_KEY=<64-hex>
S3_BUCKET=sources
# Per-file upload ceiling in MB (0 disables the cap).
MAX_UPLOAD_MB=500