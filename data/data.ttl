# TEST FIXTURE DATA ONLY.
# Canonical runtime vocabulary seeding is sourced from data/vocab.ttl.

rfdb:LibrettoManoscritto a core:Type ;
    rdfs:label "Libretto Manoscritto"@en .

rfdb:LibrettoStampa a core:Type ;
    rdfs:label "Libretto a Stampa"@en .

rfdb:Libretto_11 a lrmoo:F2_Expression ;
    rdfs:label "La *forza dell'amore e dell'odio"@en ;
    core:hasAgentRole rfdb:AR_3 .

rfdb:Libretto_11_manifestation a lrmoo:F3_Manifestation ;
    rdfs:label "La *forza dell'amore e dell'odio printed manifestation"@en ;
    lrmoo:R4_embodies rfdb:Libretto_11 .

rfdb:Libretto_11a a source:Source, lrmoo:F5_Item ;
    rdfs:label "La *forza dell'amore e dell'odio"@en ;
    prism:publicationDate "1736"^^xsd:gYear ;
    dcterms:identifier "Rossica 13.8.5.44"^^xsd:string ;
    lrmoo:R7_exemplifies rfdb:Libretto_11_manifestation ;
    cidoc:P51_has_former_or_current_owner rfdb:HO_1 ;
    core:hasPlace rfdb:Place_P1 ;
    core:hasType rfdb:Libretto .

rfdb:Person_1 a core:Person ;
    rdfs:label "Pallavicino, Stefano Benedetto"@en ;
    owl:sameAs wd:Q321084 .

rfdb:Person_3 a core:Person ;
    rdfs:label "Metastasio, Pietro"@en ;
    owl:sameAs wd:Q29473 .

rfdb:Place_P2 a core:Place ;
    rdfs:label "Milano"@en ;
    owl:sameAs wd:Q490 .

rfdb:Traduttore a core:Role ;
    rdfs:label "Traduttore"@en .

rfdb:Compositore a core:Role ;
    rdfs:label "Compositore"@en .

rfdb:HO_1 a core:Organization ;
    rdfs:label "Rus-SPsc"@en ;
    owl:sameAs wd:Q267566 ;
    core:hasPlace rfdb:Place_P1 ;
    skos:altLabel "Russian National Library"@en .

rfdb:Librettista a core:Role ;
    rdfs:label "Librettista"@en .

rfdb:Libretto a core:Type ;
    rdfs:label "Libretto"@en .

rfdb:Person_2 a core:Person ;
    rdfs:label "Prata, Franceso"@en .

rfdb:Person_4 a core:Person ;
    rdfs:label "Araja,Francesco"@en .

rfdb:Place_P1 a core:Place ;
    rdfs:label "San Pietroburgo"@en ;
    owl:sameAs wd:Q656 .

rfdb:T11 a mm:MusicEntity, lrmoo:F1_Work ;
    rdfs:label "La *forza dell'amore e dell'odio"@en ;
    owl:sameAs wd:Q55064333 ;
    cidoc:P148_has_component rfdb:Libretto_11 ;
    core:hasAgentRole rfdb:AR_1,
        rfdb:AR_2 .

rfdb:AR_1 a core:AgentRole ;
    core:hasAgent rfdb:Person_2 ;
    core:hasRole rfdb:Librettista .

rfdb:AR_2 a core:AgentRole ;
    core:hasAgent rfdb:Person_4 ;
    core:hasRole rfdb:Compositore .

rfdb:AR_3 a core:AgentRole ;
    core:hasAgent rfdb:Person_2 ;
    core:hasRole rfdb:Librettista .


