# ============================================================
# RFDB Data Explorer Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values for local development.
# In Docker Compose all variables are provided via the environment:
# block in docker-compose.yml — .env is NOT used inside containers.
#
# This is the read service. Its settings are exactly
# rfdb_core.config.BaseServiceSettings — the shared base — with no additions.
# Compare curator-backend/.env.example: everything there and not here is a write
# concern (VOCAB_PATH, DATA_PATH, RESET_DATA_ON_STARTUP, SEED_*, READ_ONLY,
# READ_ONLY_SHAPES, MAX_UPLOAD_MB). Setting any of them here has no effect —
# extra="ignore" means this service does not see them, so a single shared .env
# across both services is safe.
#
# REQUIRED: all variables below must be set; the application will
# refuse to start and print a clear error for any missing variable.
# ============================================================

# ----------------------------------------------------------
# Triple store
# ----------------------------------------------------------

# Which TripleStore implementation to build. Only "oxigraph" ships today; the
# seam (rfdb_core.triplestore) exists so a second one is a config change.
TRIPLESTORE=oxigraph

# Base URL of the Oxigraph HTTP endpoint (no trailing slash).
# Local dev: http://localhost:7878
# Docker Compose: http://oxigraph:7878  (service name resolves inside Docker)
OXIGRAPH_URL=http://localhost:7878

# Named graph URI that reads are scoped to (FROM <uri>). Must match the graph
# curator-backend writes to, or this service will correctly report an empty store.
DATA_GRAPH_URI=https://rosfeatr.eu/rdf/graph/

# Read timeout (seconds) for bulk Turtle loads. Unused here — this service never
# loads Turtle — but it is part of the shared settings base, so it is listed for
# completeness. Default: 300.
OXIGRAPH_LOAD_TIMEOUT=300

# ----------------------------------------------------------
# File paths (relative to the dataexplorer-backend working directory)
# ----------------------------------------------------------

# Path to the SHACL schema file used by SchemaExtractor. Read-only here: the
# schema is the map every read route navigates by (which shapes exist, which
# predicates count as relations), never something this service validates against.
# In Docker the schema/ folder is mounted read-only at /app/schema/.
SCHEMA_PATH=schema/schema.ttl

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------

# JSON array of allowed browser origins. Must NOT contain "*" — the app aborts at
# import time if it does, because the CORS spec forbids a wildcard alongside
# allow_credentials=True and the middleware fails silently rather than loudly.
#
# Both frontends read from this service, so both dev origins belong here:
# :5173 = curator-frontend; graphexplorer-frontend is published on host port 80 (http's
# default port, so its browser Origin omits the port entirely).
CORS_ORIGINS=["http://localhost:5173", "http://localhost"]

# ----------------------------------------------------------
# Object storage (Garage / S3-compatible) — digital-copy downloads
# ----------------------------------------------------------

# Leave S3_ENDPOINT empty to run without object storage: GET /api/meta/files then
# reports {"configured": false} with zeroed stats instead of erroring, and the
# panel still renders. Downloads will 503.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=sources
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------

# Structured JSON-lines log file. In Docker this is pinned to the
# dataexplorer_backend_logs volume mounted at /app/logs.
LOG_FILE=logs/app.jsonl
LOG_LEVEL=INFO

# Keep crash/restart history, but truncate once when a fresh container starts.
TRUNCATE_LOG_ON_STARTUP=false
TRUNCATE_LOG_ON_FRESH_CONTAINER_START=true
