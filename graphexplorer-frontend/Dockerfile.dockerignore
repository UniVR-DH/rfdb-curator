# graphexplorer-frontend/Dockerfile.dockerignore
#
# The ignore file for the Dockerfile beside it, and for that build only.
# Compose builds with the repo root as context, so BuildKit reads this file in
# place of the root .dockerignore, and every pattern below is relative to the
# repo root. A bare pattern such as `.env` would match only at the root, so each
# one carries a `**/` prefix to match at any depth.

# Seed data: nothing in this Dockerfile COPYs it, and the services that need it
# get it at runtime through a compose bind-mount.
data

# Dependencies: reinstalled cleanly by `npm ci` inside the image. A host
# node_modules carries host-arch native binaries (esbuild) that would clobber the
# ones the image just installed.
**/node_modules

# Build output: the build stage produces its own.
**/dist
**/build

# Environment files: must never be baked into an image.
**/.env
**/.env.*
!**/.env.example

# Editor and OS noise.
**/.DS_Store
**/*.log
**/.vscode
**/.idea

# Git internals.
.git
**/.gitignore
